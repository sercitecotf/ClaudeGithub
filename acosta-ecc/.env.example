# Copia este archivo como ".env" y rellénalo. NO lo subas a GitHub.

# Clave de cifrado de las solicitudes (genérala con: npm run generar-clave). GUÁRDALA aparte: sin ella no se pueden leer los datos.
ACOSTA_CLAVE=

# Contraseña para entrar al panel desde fuera (usuario: jose). Mínimo 12 caracteres.
PANEL_CLAVE=

# Dirección del panel, para que el aviso lleve el enlace.
PANEL_URL=https://soldaduraacosta.es/panel

# Avisos de nueva solicitud en el móvil (sin datos personales). Elige UNO:
# 1) ntfy: instala la app "ntfy" y suscríbete a un nombre largo e imposible de adivinar
NTFY_TOPIC=
# 2) Telegram: crea un bot con @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
