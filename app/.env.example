# Copia este archivo a ".env" y rellena los valores reales. ".env" nunca se
# sube al repositorio (ver .gitignore).

# Genera uno nuevo con:
#   python3 -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# False en producción. True solo en una máquina de desarrollo local.
DJANGO_DEBUG=False

# Dominios/IPs desde los que se sirve la app, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Vacío = SQLite local (solo para desarrollo). En producción, Postgres:
#   postgres://usuario:clave@host:5432/qualitus_next
DATABASE_URL=

# --- SAP Business One / Service Layer -------------------------------------
# El usuario ya tiene esta conexión funcionando en otros paneles; estos
# valores deben coincidir con los que usa esa integración existente, no
# inventarse nuevos.
SAP_SERVICE_LAYER_BASE_URL=
SAP_SERVICE_LAYER_COMPANY_DB=
SAP_SERVICE_LAYER_USERNAME=
SAP_SERVICE_LAYER_PASSWORD=
SAP_SERVICE_LAYER_VERIFY_TLS=True
